---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const aboutPost = await getEntry("spec", "about-en");

if (!aboutPost) {
	throw new Error("English about page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title="About" description="About M0th9n" lang="en">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <div class="flex justify-end mb-3">
                <a href={url("/about/")} hreflang="zh" title="以中文阅读本页"
                   class="btn-regular rounded-lg h-8 px-3 flex items-center gap-1.5 text-sm font-medium active:scale-95">
                    <Icon name="material-symbols:translate" class="text-[1.125rem]" />
                    <span>中文</span>
                </a>
            </div>
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
