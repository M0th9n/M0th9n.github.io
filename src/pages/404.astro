---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="404" description="页面不存在">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center text-center">
            <Icon name="material-symbols:search-off-rounded" class="text-[4rem] text-[var(--primary)] mb-2"></Icon>
            <div class="text-3xl font-bold mb-3">404</div>
            <p class="text-black/60 dark:text-white/60 mb-8">这里什么都没有，页面可能已被移动或删除。</p>
            <a href="/" class="btn-regular rounded-lg h-10 px-5 font-medium">返回首页</a>
        </div>
    </div>
</MainGridLayout>
